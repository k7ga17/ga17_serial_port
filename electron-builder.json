{
  "appId": "com.ga17.serial-port",
  "productName": "GA17 Serial Port",
  "directories": {
    "output": "dist"
  },
  "win": {
    "target": [
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "assets/icon.ico"
  },
  "files": [
    "src/**/*",
    "assets/**/*",
    "node_modules/**/*"
  ],
  "asar": true,
  "asarUnpack": [
    "node_modules/@serialport/**/*",
    "node_modules/iconv-lite/**/*"
  ],
  "npmRebuild": true
}